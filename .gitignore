# 依赖
node_modules/

# 构建产物
/dist/
/.astro/

# 构建时生成的常量（scripts/generate-icons.js、generate-lqips.ts 生成）
/src/constants/icons.ts
/src/constants/lqips.json

# 构建/dev 时由 generate-post-meta 插件生成的随机文章数据源
/public/api/

# 环境变量
.env
.env.production
.env.*.local

# 包管理器（统一使用 pnpm，忽略其它锁文件）
package-lock.json
bun.lockb
yarn.lock

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare Workers 可选部署路径（astro.config.mjs 的 CF_WORKERS 分支）
/.wrangler/
.dev.vars

# IDE / 系统文件
/.idea/
*.iml
.DS_Store