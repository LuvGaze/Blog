# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 高德地图 Key（足迹地图底图渲染）
# 申请地址: https://console.amap.com/dev/key/app（选择 Web端(JS API)）
PUBLIC_AMAP_KEY_PLACES=

# 高德 JSAPI 安全密钥（Web端 JS API Key 配套）
# 与 PUBLIC_AMAP_KEY_PLACES 对应，在高德控制台该 JS API Key 的「安全设置」里查看并填写
# 不填的话地图底图可能加载不出来（JS API 2.0 多数需要安全密钥）
PUBLIC_AMAP_SECURITY_JS_CODE=

# 高德地图 Key（自动地理编码，可选）
# 用途：给只有「省份/城市」的足迹地点自动补齐经纬度，从而显示在地图上
# 在控制台申请「Web服务」类型的 Key，把「Key」填到 PUBLIC_AMAP_GEO_KEY，
# 把该 Key 对应的「安全密钥/密钥」填到 PUBLIC_AMAP_GEO_SECRET（若该 Key 开启了安全码才需要填）
# 不需要自动补坐标的话可留空，改用后台手动填写 lat/lng
PUBLIC_AMAP_GEO_KEY=
PUBLIC_AMAP_GEO_SECRET=

# 账单页访问密码（留空则不加密，直接展示账单）
# 修改后需重新构建站点才会生效
GATE_PASSWORD=