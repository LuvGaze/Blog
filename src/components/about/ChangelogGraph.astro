---
import { getCollection } from "astro:content";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	buildChangelogLinks,
	type ChangelogType,
	changelogEntriesFromCollection,
} from "@/utils/changelog";

interface Props {
	limit?: number;
}
const { limit = 30 } = Astro.props as Props;
const raw = await getCollection("changelog");
const entries = changelogEntriesFromCollection(raw);
const CHANGELOG_DISPLAY_LIMIT =
	limit > 0 ? Math.min(limit, entries.length) : entries.length;

const total = entries.length;
const visibleEntries = entries.slice(0, CHANGELOG_DISPLAY_LIMIT);
const hiddenEntryCount = total - visibleEntries.length;
const links = buildChangelogLinks(visibleEntries);
const recentLimitMessage = `仅显示最近 ${CHANGELOG_DISPLAY_LIMIT} 条，点击卡片查看详情。`;

const typeLabels: Record<ChangelogType, string> = {
	feature: i18n(I18nKey.changelogFeature),
	improvement: i18n(I18nKey.changelogImprovement),
	fix: i18n(I18nKey.changelogFix),
	removal: i18n(I18nKey.changelogRemoval),
};
---

<div class="changelog" data-changelog>
	<div class="changelog__heading">
		<h2 class="changelog__section-title">{i18n(I18nKey.changelogTitle)}</h2>
		{hiddenEntryCount > 0 && <span class="changelog__recent-limit">{recentLimitMessage}</span>}
	</div>

	<svg class="changelog__wires" data-changelog-wires aria-hidden="true">
		<defs>
			<marker id="changelog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
				<path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
			</marker>
		</defs>
	</svg>

	<ol class="changelog__grid" data-changelog-grid>
		{visibleEntries.map((entry, i) => {
			const num = total - i;
			const entryLinks = links.get(i) ?? [];
			return (
				<li class="changelog-card" data-changelog-card data-index={i} data-num={num} data-type={entry.type} data-links={JSON.stringify(entryLinks.map((l) => ({ t: l.target, label: l.label })))}>
					<a class="changelog-card__inner" href={`/changelog/${entry.id}/`}>
						<span class="changelog-card__num" aria-hidden="true">{String(num).padStart(2, "0")}</span>
						<span class="changelog-card__meta">
							<span class="changelog-card__type">{typeLabels[entry.type]}</span>
							<time class="changelog-card__date" datetime={entry.date}>{entry.date}</time>
						</span>
						<span class="changelog-card__title">{entry.title}</span>
						<span class="changelog-card__summary">{entry.summary}</span>
					</a>
				</li>
			);
		})}
	</ol>
</div>

<style is:global>
	/* ==========================================================================
	   更新日志链路图谱（/changelog/ 页使用）
	   蛇形网格 + 行间回环箭头 + 悬停 SVG 虚线关联（按作者手选的 related 字段）
	   ========================================================================== */

	.changelog {
		position: relative;
	}

	.changelog__heading {
		position: relative;
		z-index: 3;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 1.25rem;
	}

	.changelog__section-title {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin: 0;
		color: var(--deep-text);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.changelog__section-title::before {
		content: "";
		width: 5px;
		height: 1.375rem;
		flex: 0 0 5px;
		border-radius: 999px;
		background: var(--primary);
	}

	.changelog__recent-limit {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--content-meta);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.changelog__recent-limit::before {
		content: "/";
		color: var(--line-divider);
	}

	.changelog__wires {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.changelog-wire {
		fill: none;
		stroke-width: 1.5;
	}

	.changelog-wire--row {
		stroke: var(--primary);
		opacity: 0.35;
	}

	.changelog-wire--hover {
		stroke: var(--primary);
		stroke-width: 1.75;
	}

	.changelog-wire--hover.is-drawn {
		stroke-dasharray: 6 5;
		animation: changelog-dash 0.7s linear infinite;
	}

	.changelog-wire-arrow {
		fill: var(--primary);
	}

	.changelog-wire-label {
		position: absolute;
		z-index: 3;
		max-width: 12rem;
		padding: 0.25rem 0.625rem;
		overflow: hidden;
		border: 1px solid var(--line-color);
		border-radius: 999px;
		background: var(--card-bg);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
		color: var(--primary);
		font-size: 0.6875rem;
		font-weight: 700;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		transform: translate(-50%, -50%);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.35s ease 0.1s,
			visibility 0.35s ease 0.1s;
		visibility: hidden;
	}

	.changelog-wire-label.is-in {
		opacity: 1;
		visibility: visible;
	}

	@keyframes changelog-dash {
		to {
			stroke-dashoffset: -11;
		}
	}

	.changelog__grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.changelog-card {
		aspect-ratio: 1 / 1;
		position: relative;
		min-width: 0;
		transition: opacity 0.25s ease;
	}

	.changelog-card__inner {
		position: relative;
		display: flex;
		width: 100%;
		height: 100%;
		min-height: 0;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.875rem 1rem;
		overflow: hidden;
		border: 0;
		border-radius: var(--radius-lg);
		background: var(--card-bg);
		text-align: start;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			background-color 0.18s ease;
	}

	.changelog-card__inner:hover {
		transform: translateY(-2px);
	}

	.changelog-card__inner:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.changelog-card__num {
		position: absolute;
		right: 0.625rem;
		bottom: -0.625rem;
		color: var(--deep-text);
		font-size: 2.75rem;
		font-weight: 800;
		line-height: 1;
		opacity: 0.09;
		pointer-events: none;
		user-select: none;
	}

	.changelog-card__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		line-height: 1.4;
	}

	.changelog-card__type {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		font-weight: 700;
	}

	.changelog-card__type::before {
		content: "";
		width: 0.4375rem;
		height: 0.4375rem;
		flex: 0 0 0.4375rem;
		border-radius: 999px;
		background: var(--changelog-type-color, var(--primary));
	}

	.changelog-card[data-type="feature"] {
		--changelog-type-color: #1d9e75;
	}
	.changelog-card[data-type="improvement"] {
		--changelog-type-color: #7f77dd;
	}
	.changelog-card[data-type="fix"] {
		--changelog-type-color: #e24b4a;
	}
	.changelog-card[data-type="removal"] {
		--changelog-type-color: #ef9f27;
	}

	.changelog-card__type {
		color: var(--changelog-type-color, var(--primary));
	}

	.changelog-card__date {
		color: var(--content-meta);
	}

	.changelog-card__title {
		color: var(--deep-text);
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.changelog-card__summary {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--content-meta);
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.changelog.is-hovering .changelog-card {
		opacity: 0.3;
	}

	.changelog.is-hovering .changelog-card.is-active,
	.changelog.is-hovering .changelog-card.is-linked {
		opacity: 1;
	}

	.changelog-card.is-active .changelog-card__inner {
		transform: translateY(-2px);
		box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
	}

	.changelog-card.is-linked .changelog-card__inner {
		box-shadow: inset 0 0 0 1.5px var(--primary);
	}

	.changelog-card.is-flash .changelog-card__inner {
		animation: changelog-flash 1.3s ease;
	}

	@keyframes changelog-flash {
		0%,
		55% {
			box-shadow: inset 0 0 0 2px var(--primary);
		}
		100% {
			box-shadow: none;
		}
	}

	@media (max-width: 1024px) {
		.changelog__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 768px) {
		.changelog__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 560px) {
		.changelog__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.625rem;
		}

		.changelog-card__inner {
			min-height: 0;
			padding: 0.75rem 0.875rem;
		}

		.changelog-card__num {
			font-size: 2.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.changelog-wire--hover,
		.changelog-wire--hover.is-drawn {
			animation: none;
		}

		.changelog-wire-label {
			transition: none;
		}

		.changelog-card__inner,
		.changelog-card {
			transition: none;
			animation: none;
		}
	}
</style>

<script is:inline>
	function initChangelogGraph() {
		const rootEl = document.querySelector("[data-changelog]");
		if (!rootEl) return;
		const root = rootEl;
		if (root.__cleanup) root.__cleanup();
		const ac = new AbortController();
		const signal = ac.signal;
		root.__cleanup = () => ac.abort();
		const NS = "http://www.w3.org/2000/svg";
		const grid = root.querySelector("[data-changelog-grid]");
		const wiresSvg = root.querySelector("[data-changelog-wires]");
		if (!grid || !wiresSvg) return;
		let activeCard = null;
		const wireAnims = new Set();
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		function visibleCards() { return Array.from(grid.querySelectorAll("[data-changelog-card]")); }
		function sizeSvg() { if (wiresSvg) wiresSvg.setAttribute("viewBox", `0 0 ${root.scrollWidth} ${root.scrollHeight}`); }
		function rootRect() { return root.getBoundingClientRect(); }
		function cardCenter(card) {
			const r = card.getBoundingClientRect();
			const rr = rootRect();
			return { x: r.left - rr.left + r.width / 2, y: r.top - rr.top + r.height / 2 };
		}
		function makePath(d, cls, marker) {
			if (marker === undefined) marker = true;
			const p = document.createElementNS(NS, "path");
			p.setAttribute("d", d); p.setAttribute("class", cls);
			if (marker) p.setAttribute("marker-end", "url(#changelog-arrow)");
			return p;
		}
		function layout() {
			const cards = visibleCards();
			if (cards.length === 0) return;
			const cols = Math.max(1, getComputedStyle(grid).gridTemplateColumns.split(" ").length);
			cards.forEach((card, i) => {
				const row = Math.floor(i / cols);
				const col = i % cols;
				const visualCol = row % 2 === 0 ? col : cols - 1 - col;
				card.style.order = String(row * cols + visualCol);
			});
			drawRowArrows(cards, cols);
			clearHoverWires();
		}
		function drawRowArrows(cards, cols) {
			sizeSvg();
			wiresSvg.querySelectorAll("[data-row-arrow]").forEach((n) => n.remove());
			const rows = Math.ceil(cards.length / cols);
			const rr = rootRect();
			for (let r = 0; r < rows - 1; r++) {
				const fromCard = cards[r * cols + cols - 1];
				const toCard = cards[(r + 1) * cols];
				if (!fromCard || !toCard) continue;
				const fr = fromCard.getBoundingClientRect();
				const tr = toCard.getBoundingClientRect();
				const fy = fr.top - rr.top + fr.height / 2;
				const ty = tr.top - rr.top + tr.height / 2;
				let d;
				if (r % 2 === 0) {
					const x1 = fr.right - rr.left; const x2 = tr.right - rr.left;
					const out = Math.max(x1, x2) + 16;
					d = `M ${x2} ${ty} H ${out} V ${fy} H ${x1}`;
				} else {
					const x1 = fr.left - rr.left; const x2 = tr.left - rr.left;
					const out = Math.min(x1, x2) - 16;
					d = `M ${x2} ${ty} H ${out} V ${fy} H ${x1}`;
				}
				const path = makePath(d, "changelog-wire changelog-wire--row");
				path.setAttribute("data-row-arrow", "");
				wiresSvg.appendChild(path);
			}
		}
		function clearHoverWires() {
			for (const cancel of wireAnims) cancel();
			wireAnims.clear();
			root.querySelectorAll("[data-hover-wire]").forEach((n) => n.remove());
			root.classList.remove("is-hovering");
			root.querySelectorAll(".is-active, .is-linked").forEach((c) => c.classList.remove("is-active", "is-linked"));
		}
		function drawHoverWire(d, mid, labelText) {
			const path = makePath(d, "changelog-wire changelog-wire--hover", false);
			path.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(path);
			const label = document.createElement("span");
			label.className = "changelog-wire-label";
			label.textContent = labelText;
			label.setAttribute("data-hover-wire", "");
			label.style.left = `${mid.x}px`;
			label.style.top = `${mid.y}px`;
			root.appendChild(label);
			if (reducedMotion) {
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				label.classList.add("is-in");
				return;
			}
			const len = path.getTotalLength();
			const dur = Math.min(0.75, Math.max(0.35, len / 700));
			const DASH = 6; const GAP = 5;
			const revealDash = (drawn) => {
				const segments = [];
				let used = 0; let isDash = true;
				while (used < drawn) {
					const take = Math.min(isDash ? DASH : GAP, drawn - used);
					segments.push(take); used += take; isDash = !isDash;
				}
				if (segments.length === 0) segments.push(0);
				if (segments.length % 2 === 0) segments.push(0);
				segments.push(len + DASH + GAP);
				path.style.strokeDasharray = segments.join(" ");
			};
			const arrow = document.createElementNS(NS, "polygon");
			arrow.setAttribute("points", "-8.5,-4.5 0,0 -8.5,4.5");
			arrow.setAttribute("class", "changelog-wire-arrow");
			arrow.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(arrow);
			const easeOutCubic = (t) => 1 - (1 - t) ** 3;
			const start = performance.now();
			let raf = 0;
			const cancel = () => { cancelAnimationFrame(raf); arrow.remove(); };
			wireAnims.add(cancel);
			const tick = (now) => {
				const t = Math.min(1, (now - start) / (dur * 1000));
				const drawn = len * easeOutCubic(t);
				revealDash(drawn);
				const tip = path.getPointAtLength(drawn);
				const back = path.getPointAtLength(Math.max(0, drawn - 1));
				const fwd = path.getPointAtLength(Math.min(len, drawn + 1));
				const deg = (Math.atan2(fwd.y - back.y, fwd.x - back.x) * 180) / Math.PI;
				arrow.setAttribute("transform", `translate(${tip.x} ${tip.y}) rotate(${deg})`);
				if (t < 1) { raf = requestAnimationFrame(tick); return; }
				wireAnims.delete(cancel);
				path.style.strokeDasharray = "";
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				arrow.remove();
				label.classList.add("is-in");
			};
			raf = requestAnimationFrame(tick);
		}
		function onCardEnter(card) {
			clearHoverWires();
			sizeSvg();
			const links = JSON.parse(card.dataset.links || "[]");
			const cardIndex = Number(card.dataset.index);
			const from = cardCenter(card);
			root.classList.add("is-hovering");
			card.classList.add("is-active");
			for (const link of links) {
				const target = root.querySelector(`[data-changelog-card][data-index="${link.t}"]`);
				if (!target) continue;
				target.classList.add("is-linked");
				const to = cardCenter(target);
				const dx = to.x - from.x; const dy = to.y - from.y;
				const len = Math.hypot(dx, dy) || 1;
				const off = Math.min(56, len * 0.12);
				const cx = (from.x + to.x) / 2 - (dy / len) * off;
				const cy = (from.y + to.y) / 2 + (dx / len) * off;
				const mid = { x: from.x * 0.25 + cx * 0.5 + to.x * 0.25, y: from.y * 0.25 + cy * 0.5 + to.y * 0.25 };
				const isNewer = link.t < cardIndex;
				const start = isNewer ? from : to;
				const end = isNewer ? to : from;
				drawHoverWire(`M ${start.x} ${start.y} Q ${cx} ${cy} ${end.x} ${end.y}`, mid, link.label);
			}
		}
		grid.addEventListener("pointerover", (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			const card = t.closest("[data-changelog-card]");
			if (!card || card === activeCard) return;
			activeCard = card; onCardEnter(card);
		}, { signal });
		grid.addEventListener("pointerleave", () => { activeCard = null; clearHoverWires(); }, { signal });
		window.addEventListener("resize", layout, { signal });
		layout();
	}
	initChangelogGraph();
	document.addEventListener("astro:page-load", initChangelogGraph);
	document.addEventListener("swup:content:replaced", initChangelogGraph);
</script>