---
import { Icon } from "astro-icon/components";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
}

const { link, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;

const hasChildren = processedLink.children && processedLink.children.length > 0;
---

<div class:list={["dropdown-container nav-expand-container", className]} data-dropdown data-nav-expand>
	{hasChildren ? (
		<>
			<button
				class="nav-expand-trigger btn-plain scale-animation rounded-full h-10 font-bold px-4 active:scale-95"
				aria-expanded="false"
				aria-haspopup="true"
				data-dropdown-trigger
			>
				<div class="flex items-center gap-1.5">
					{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					{processedLink.name}
				</div>
			</button>
			<div class="nav-expand-body" data-nav-expand-body>
				<div class="nav-expand-items" data-nav-expand-items>
					{processedLink.children?.map((child) => (
						<a
							href={child.external ? child.url : url(child.url)}
							target={child.external ? "_blank" : undefined}
							rel={child.external ? "noopener noreferrer" : undefined}
							class="nav-expand-item dropdown-item"
							aria-label={child.name}
						>
							{child.icon && <Icon is:inline name={child.icon} class="text-[1.05rem] flex-shrink-0" />}
							<span class="nav-expand-label">{child.name}</span>
							{child.external && (
								<Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.7rem] opacity-30 flex-shrink-0" />
							)}
						</a>
					))}
				</div>
			</div>
		</>
	) : (
		<a
			aria-label={processedLink.name}
			href={processedLink.external ? processedLink.url : url(processedLink.url)}
			target={processedLink.external ? "_blank" : null}
			class="btn-plain scale-animation rounded-full h-10 font-bold px-4 active:scale-95"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
				{processedLink.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
	}

	/* ── 横向展开菜单（复刻 jerrynis.com 顶栏） ── */
	.nav-expand-container {
		display: inline-flex;
		align-items: center;
		border-radius: 9999px;
	}

	.nav-expand-trigger {
		flex-shrink: 0;
	}

	.nav-expand-body {
		width: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.25s ease;
	}

	.nav-expand-container.is-open .nav-expand-body {
		width: var(--nav-expand-w, 0px);
		opacity: 1;
	}

	.nav-expand-items {
		display: flex;
		align-items: center;
		gap: 0.0625rem;
		width: max-content;
		margin: 0.125rem 0.15rem;
		padding: 0.0625rem 0.3rem;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--deep-text) 7%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--deep-text) 5%, transparent);
	}

	.nav-expand-item {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		height: 2rem;
		padding: 0 0.6rem;
		border-radius: 9999px;
		font-size: 0.8125rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--deep-text);
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.nav-expand-item:hover,
	.nav-expand-item:focus-visible {
		background: color-mix(in oklch, var(--deep-text) 10%, transparent);
		color: var(--primary);
	}

	.nav-expand-label {
		display: inline-block;
	}

	.nav-expand-container.is-open .nav-expand-trigger {
		color: var(--primary);
	}

	/* 移动端隐藏下拉菜单 */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	function initNavExpand() {
		document.querySelectorAll<HTMLElement>('[data-nav-expand]').forEach((el) => {
			if (el.dataset.expandReady === 'true') return;
			el.dataset.expandReady = 'true';

			const body = el.querySelector<HTMLElement>('[data-nav-expand-body]');
			const items = el.querySelector<HTMLElement>('[data-nav-expand-items]');
			const trigger = el.querySelector<HTMLElement>('[data-dropdown-trigger]');
			if (!body || !items || !trigger) return;

			const measure = () => {
				el.style.setProperty('--nav-expand-w', `${Math.ceil(items.getBoundingClientRect().width) + 4}px`);
			};

			measure();
			if (document.fonts?.ready) document.fonts.ready.then(measure);

			const open = () => {
				measure();
				el.classList.add('is-open');
				trigger.setAttribute('aria-expanded', 'true');
				window.dispatchEvent(new CustomEvent('nav-expand-toggle'));
			};
			const close = () => {
				el.classList.remove('is-open');
				trigger.setAttribute('aria-expanded', 'false');
				window.dispatchEvent(new CustomEvent('nav-expand-toggle'));
			};

			el.addEventListener('mouseenter', open);
			el.addEventListener('mouseleave', close);
			el.addEventListener('focusin', open);
			el.addEventListener('focusout', (event) => {
				if (!el.contains(event.relatedTarget as Node)) close();
			});

			// 键盘支持：Esc 关闭
			el.addEventListener('keydown', (event) => {
				if ((event as KeyboardEvent).key === 'Escape') {
					close();
					trigger.focus();
				}
			});
		});
	}

	initNavExpand();
	document.addEventListener('swup:contentReplaced', () => setTimeout(initNavExpand, 50));
</script>
