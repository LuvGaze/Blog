---
/**
 * 博客自定义鼠标光标
 * - 使用 cursorConfig 中配置的图片（png / gif / svg / cur / ico）
 * - 未配置图片时不做任何替换，保持系统默认箭头
 * - 触屏设备不受影响；输入框仍保留系统文本光标
 */
import { cursorConfig } from "@/config/cursorConfig";

const { enable, default: defaultImage, pointer, hotspotX, hotspotY } = cursorConfig;

// 兼容外部链接与本地相对路径，空值视为未配置
function toCursor(src: string): string {
	const trimmed = String(src || "").trim();
	if (!trimmed) return "";
	return `url("${trimmed}") ${hotspotX} ${hotspotY}, auto`;
}

const defaultCursor = enable ? toCursor(defaultImage) : "";
const pointerCursor = enable ? toCursor(pointer) || defaultCursor : "";

const rules: string[] = [];
if (defaultCursor) {
	rules.push(`html,
html body {
	cursor: ${defaultCursor};
}`);
}
if (pointerCursor) {
	rules.push(`a,
button,
[role="button"],
[role="link"],
input[type="submit"],
input[type="button"],
input[type="reset"],
label,
summary,
.btn-plain,
.navbar-seg,
.dropdown-item,
.nav-expand-item {
	cursor: ${pointerCursor};
}`);
}
const css = rules.join("\n");
---

{css && <style is:global set:html={css} />}
