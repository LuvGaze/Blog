---
import EncryptedContent from "@/components/features/EncryptedContent.astro";
import { accessConfig } from "@/config/accessConfig";

interface Props {
	slug: string;
	hint?: string;
}
const { slug, hint } = Astro.props;
---

<EncryptedContent password={accessConfig.password || import.meta.env.GATE_PASSWORD || ""} slug={slug} hint={hint || accessConfig.hint}>
	<slot />
</EncryptedContent>