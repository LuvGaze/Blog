---
/**
 * 全局本地字体加载
 *
 * 读取 fontConfig 中配置的字体文件，生成 @font-face 并设置 body 字体。
 * fontFile 留空时不输出任何样式，全站使用系统默认字体。
 */
import { fontConfig } from "@/config/fontConfig";

const file = fontConfig.enable ? fontConfig.fontFile.trim() : "";
const family = (
	fontConfig.fontFamily?.trim() ||
	file.split("/").pop()?.replace(/\.(woff2?|ttf|otf)$/i, "") ||
	""
)
	.replace(/"/g, "")
	.trim();

const ext = file.split(".").pop()?.toLowerCase() || "";
const format =
	ext === "woff2"
		? "woff2"
		: ext === "woff"
			? "woff"
			: ext === "otf"
				? "opentype"
				: "truetype";

const css =
	file && family
		? `@font-face {
		font-family: "${family}";
		src: url("${file}") format("${format}");
		font-weight: ${fontConfig.fontWeight ?? 400};
		font-style: ${fontConfig.fontStyle ?? "normal"};
		font-display: ${fontConfig.fontDisplay ?? "swap"};
	}

	body {
		font-family: "${family}", system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	}`
		: "";
---

{css && <style is:global set:html={css} />}
