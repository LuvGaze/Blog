---
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import Markdown from "@/components/common/Markdown.astro";
import { profileConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getTagUrl } from "@/utils/url-utils";

// 未在 frontmatter 指定 avatar 时，回退到博客作者头像（ImageWrapper 支持 src/assets 相对路径）
const DEFAULT_AVATAR = profileConfig.avatar || "";

interface Props {
	moment: CollectionEntry<"moments">;
}

const { moment } = Astro.props;
const { Content } = await render(moment);
const { author, avatar, published, images, tags, location, pinned } =
	moment.data;

// 视频文件扩展名
const VIDEO_EXTENSIONS = new Set(["mp4", "webm", "mov", "ogg", "avi", "mkv"]);

const isVideoUrl = (url: string): boolean => {
	try {
		const pathname = new URL(url, "http://localhost").pathname;
		const ext = pathname.split(".").pop()?.toLowerCase() ?? "";
		return VIDEO_EXTENSIONS.has(ext);
	} catch {
		return false;
	}
};

// 解析图片路径，同时分离视频（支持数组或逗号/分号分隔的字符串）
const parseImages = (imagesData: string | string[] | undefined): string[] => {
	let rawPaths: string[] = [];
	if (Array.isArray(imagesData)) {
		rawPaths = imagesData;
	} else if (typeof imagesData === "string" && imagesData.trim()) {
		rawPaths = imagesData
			.split(/[,;]/)
			.map((img) => img.trim())
			.filter((img) => img);
	}
	return Array.from(new Set(rawPaths));
};

// 计算图片网格列数
const getGridCols = (count: number) => {
	if (count === 1) return 1;
	if (count === 2 || count === 4) return 2;
	return 3;
};

const allMedia = parseImages(images);
const videosArray = allMedia.filter((item) => isVideoUrl(item));
const imagesArray = allMedia.filter((item) => !isVideoUrl(item));
const gridMax = 9;

const momentExcerpt = (moment.body || "")
	.replace(/\s+/gu, " ")
	.trim()
	.slice(0, 80);

// 相对时间
const formatTimeAgo = (date: Date): string => {
	const now = new Date();
	const diff = now.getTime() - date.getTime();
	const minutes = Math.floor(diff / 60000);
	const hours = Math.floor(diff / 3600000);
	const days = Math.floor(diff / 86400000);

	if (minutes < 1) return "刚刚";
	if (minutes < 60) return `${minutes}分钟前`;
	if (hours < 24) return `${hours}小时前`;
	if (days < 30) return `${days}天前`;
	return formatDateToYYYYMMDD(date);
};
---

<div id={moment.id} class="moment-card group">
  <div class="card-accent-bar"></div>
  <!-- 卡片头部：头像 + 用户信息 -->
  <div class="card-header">
    <div class="card-avatar">
      <ImageWrapper
        src={avatar || DEFAULT_AVATAR}
        alt={author}
        class="avatar-img"
        loading="lazy"
        widths={[64]}
        sizes="64px"
      />
    </div>
    <div class="card-user-info">
      <div class="user-row">
        <span class="user-name">{author || "匿名"}</span>
        {pinned && (
          <span class="pinned-badge">
            <Icon name="material-symbols:pinboard" class="pinned-icon" />
            <span>置顶</span>
          </span>
        )}
      </div>
      <div class="meta-row">
        <time datetime={published.toISOString()} title={formatDateToYYYYMMDD(published)}>
          {formatTimeAgo(published)}
        </time>
        {location && (
          <>
            <span class="meta-dot">·</span>
            <span class="location">
              <Icon
                name="material-symbols:location-on-outline"
                class="location-icon"
              />
              {location}
            </span>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- 内容 -->
  <div class="card-content">
    <div class="moment-markdown">
      <Markdown class="moment-markdown-content">
        <Content />
      </Markdown>
    </div>
  </div>

  <!-- 视频 -->
  {videosArray && videosArray.length > 0 && (
    <div class="card-images image-cols-1">
      {videosArray.map((videoUrl) => (
        <a
          class="image-item video-thumb"
          href={videoUrl}
          target="_blank"
          rel="noopener"
          aria-label="播放视频"
        >
          <video
            class="image-img"
            src={videoUrl}
            preload="metadata"
            playsinline
            muted
          ></video>
          <div class="video-play-overlay">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  )}

  <!-- 图片 -->
  {imagesArray && imagesArray.length > 0 && (
    <div class={`card-images image-cols-${getGridCols(imagesArray.length)}`}>
      {imagesArray.map((imgSrc, index) => {
        const isHidden = index >= gridMax;
        const isLastVisible = index === gridMax - 1 && imagesArray.length > gridMax;

        return (
          <div class={`image-item ${isHidden ? "hidden-image" : ""}`}>
            <img
              src={imgSrc}
              alt="Moment image"
              class="image-img"
              loading="lazy"
              data-fancybox={`gallery-${moment.id}`}
              data-src={imgSrc}
            />
            {isLastVisible && (
              <div class="more-overlay">
                <span class="more-text">+{imagesArray.length - gridMax + 1}</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  )}

  <!-- 底部：标签 -->
  {tags && tags.length > 0 && (
    <div class="card-bottom-row">
      <div class="card-tags">
        {tags.map((tag) => (
          <a href={getTagUrl(tag)} class="tag-item">
            #{tag.trim()}
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  /* ============================================
   * 卡片主体
   * ============================================ */
  .moment-card {
    position: relative;
    background: var(--card-bg);
    border-radius: 0.75rem;
    padding: 1.25rem 1.25rem 1.25rem 2.25rem;
    border: 2px solid #000;
    overflow: hidden;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  :root.dark .moment-card {
    border-color: #3f3f46;
  }

  .card-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--primary);
    opacity: 0.35;
    border-radius: 0 2px 2px 0;
  }

  .moment-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  :root.dark .moment-card:hover {
    border-color: #fff;
    box-shadow: 0 4px 24px rgba(255, 255, 255, 0.08);
  }

  /* ============================================
   * 卡片头部
   * ============================================ */
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .card-avatar {
    flex-shrink: 0;
  }

  .avatar-img {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--primary);
    box-sizing: border-box;
  }

  .card-user-info {
    flex: 1;
    min-width: 0;
  }

  .user-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.125rem;
  }

  .user-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
  }

  .pinned-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    border-radius: var(--radius);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .pinned-icon {
    font-size: 0.875rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--content-meta);
  }

  .meta-dot {
    opacity: 0.5;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-icon {
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  /* ============================================
   * 内容区域
   * ============================================ */
  .card-content {
    margin-bottom: 0.75rem;
  }

  .moment-markdown :global(p) {
    margin-bottom: 0.375rem;
    word-break: break-word;
  }

  .moment-markdown :global(p:last-child) {
    margin-bottom: 0;
  }

  .moment-markdown :global(img) {
    border-radius: var(--radius);
    margin: 0.5rem 0;
    max-width: 100%;
  }

  .moment-markdown :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }

  /* ============================================
   * 视频缩略图
   * ============================================ */
  .video-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .video-thumb:hover .video-play-overlay {
    opacity: 1;
  }

  /* ============================================
   * 图片网格
   * ============================================ */
  .card-images {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .image-cols-1 {
    grid-template-columns: 100px;
  }

  .image-cols-2 {
    grid-template-columns: repeat(2, 100px);
  }

  .image-cols-3 {
    grid-template-columns: repeat(3, 90px);
  }

  .image-item {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    background: var(--bg-secondary);
    aspect-ratio: 1;
  }

  .image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-item:hover .image-img {
    transform: scale(1.03);
  }

  .hidden-image {
    display: none !important;
  }

  .more-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.45);
  }

  .more-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  /* ============================================
   * 底部行：标签
   * ============================================ */
  .card-bottom-row {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-item {
    padding: 0.25rem 0.625rem;
    background: transparent;
    border: 1px solid var(--primary);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--primary);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .tag-item:hover {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }

  /* ============================================
   * 响应式
   * ============================================ */
  @media (max-width: 480px) {
    .moment-card {
      padding: 0.875rem;
      border-radius: 0.625rem;
    }

    .avatar-img {
      width: 1.75rem;
      height: 1.75rem;
    }

    .user-name {
      font-size: 0.875rem;
    }

    .meta-row {
      font-size: 0.6875rem;
    }

    .location {
      max-width: 80px;
    }

    .card-images {
      gap: 0.25rem;
    }

    .more-text {
      font-size: 1.25rem;
    }
  }
</style>
