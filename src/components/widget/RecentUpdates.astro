---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const limit = widgetConfig?.specificConfig?.recentUpdates?.limit ?? 6;

const posts = await getSortedPosts();

// 某集合目录为空时 getCollection 会抛错，这里统一 try/catch 兜底，避免整页受影响
async function safeGet<T>(name: "bangumi" | "routines" | "travel" | "gallery" | "notebooks"): Promise<T> {
	try {
		return (await getCollection(name)) as unknown as T;
	} catch {
		return [] as unknown as T;
	}
}
const media = await safeGet<Awaited<ReturnType<typeof getCollection<"bangumi">>>>("bangumi");
const plans = await safeGet<Awaited<ReturnType<typeof getCollection<"routines">>>>("routines");
const travels = await safeGet<Awaited<ReturnType<typeof getCollection<"travel">>>>("travel");
const galleries = await safeGet<Awaited<ReturnType<typeof getCollection<"gallery">>>>("gallery");
const notebooks = await safeGet<Awaited<ReturnType<typeof getCollection<"notebooks">>>>("notebooks");

interface RecentItem {
	type: string;
	label: string;
	title: string;
	date: Date;
	url: string;
	image: string;
}

const mediaLabel: Record<string, string> = {
	books: "书架",
	games: "游戏",
	movies: "影视",
};

const items: RecentItem[] = [];

// 文章（image 为 "api" 时走随机封面逻辑，避免残留原始占位串导致裂图）
	for (const p of posts) {
		items.push({
			type: "post",
			label: "文章",
			title: p.data.title,
			date: p.data.published,
			url: getPostUrlBySlug(p.id),
			image: processCoverImageSync(p.data.image, p.id),
		});
	}

// 书架 / 游戏 / 影视
for (const m of media) {
	const seg = m.id.includes("/") ? m.id.slice(0, m.id.indexOf("/")) : "";
	const label = mediaLabel[seg] || "影视";
	const url = seg ? `/${seg}/${m.id.slice(seg.length + 1)}/` : `/bangumi/`;
	const img =
		typeof m.data.image === "string"
			? m.data.image
			: m.data.image && m.data.image.src ? m.data.image.src : "";
	items.push({
		type: "media",
		label,
		title: m.data.title,
		date: m.data.date ? new Date(m.data.date) : new Date(0),
		url,
		image: img,
	});
}

// 规划
for (const r of plans) {
	const d = r.data.updated ? new Date(r.data.updated) : new Date(0);
	items.push({
		type: "plan",
		label: "规划",
		title: r.data.name,
		date: d,
		url: `/plans/`,
		image: r.data.cover || "",
	});
}

// 足迹
for (const t of travels) {
	items.push({
		type: "travel",
		label: "足迹",
		title: t.data.title,
		date: t.data.date ? new Date(t.data.date) : new Date(0),
		url: `/travel/${t.id}/`,
		image: t.data.cover || "",
	});
}

// 相册
for (const g of galleries) {
	const img =
		g.data.cover ||
		(Array.isArray(g.data.images) && g.data.images[0]) ||
		"";
	items.push({
		type: "gallery",
		label: "相册",
		title: g.data.name,
		date: g.data.date ? new Date(g.data.date) : new Date(0),
		url: `/gallery/${g.id}/`,
		image: typeof img === "string" ? img : "",
	});
}

// 笔记本：先收集各笔记本容器（_index）信息与封面
const notebookRoots = new Map<string, { name: string; cover: string }>();
for (const nb of notebooks) {
	const nid = nb.id.replace(/\\/g, "/");
	if (/^[^/]+\/_index$/.test(nid) || /^[^/]+\/_index\.(json|md)$/.test(nid)) {
		const folder = nid.split("/")[0];
		notebookRoots.set(folder, {
			name: (nb.data as { name?: string }).name || folder,
			cover: typeof (nb.data as { cover?: unknown }).cover === "string"
				? ((nb.data as { cover?: string }).cover as string)
				: "",
		});
	}
}

// 单条笔记（带日期，按最新排序）
for (const nb of notebooks) {
	const nid = nb.id.replace(/\\/g, "/");
	if (nid === "readme" || nid.endsWith("/_index") || nid.includes("/_index.")) continue;
	const parts = nid.split("/");
	const folder = parts[0];
	const noteSlug = parts[parts.length - 1];
	const note = nb.data as { title?: string; name?: string; date?: Date | string };
	items.push({
		type: "note",
		label: "笔记",
		title: note.title || note.name || noteSlug,
		date: note.date ? new Date(note.date) : new Date(0),
		url: `/notebooks/${folder}/${noteSlug}/`,
		image: notebookRoots.get(folder)?.cover || "",
	});
}

// 笔记本容器（以最新笔记日期作为更新时间）
for (const [folder, root] of notebookRoots) {
	let latest = 0;
	for (const nb of notebooks) {
		const nid = nb.id.replace(/\\/g, "/");
		if (!nid.startsWith(folder + "/") || nid.includes("/_index")) continue;
		const d = (nb.data as { date?: Date | string }).date;
		if (d) latest = Math.max(latest, new Date(d).getTime());
	}
	items.push({
		type: "notebook",
		label: "笔记本",
		title: root.name,
		date: latest ? new Date(latest) : new Date(0),
		url: `/notebooks/${folder}/`,
		image: root.cover,
	});
}

// 排序：全部条目按日期倒序，截取前 limit 条（最大显示数量，可在后台调整 limit）
const recent = items
	.filter((i) => i.date instanceof Date && !isNaN(i.date.getTime()))
	.sort((a, b) => b.date.getTime() - a.date.getTime())
	.slice(0, Math.max(limit, 1));

function fmtDate(d: Date): string {
	if (!d || isNaN(d.getTime()) || d.getTime() <= 0) return "";
	return d.toISOString().slice(0, 10);
}
---

<WidgetLayout name="最近更新" id="recent-updates" showTitle={showTitle} class={className} style={style}>
  <Icon name="material-symbols:history-rounded" slot="title-icon" class="text-xl" />
  <div class="flex flex-col">
    {recent.map((item) => (
      <a href={item.url} class="ru-item group">
        <div class="ru-thumb">
          {item.image ? (
            <img src={item.image} alt={item.title} class="ru-thumb-img" loading="lazy" />
          ) : (
            <span class="ru-thumb-fallback">{item.title.slice(0, 1)}</span>
          )}
        </div>
        <div class="ru-body">
          <span class="ru-title">{item.title}</span>
          <span class="ru-date">
            <Icon name="material-symbols:calendar-today-outline" class="ru-date-icon" />
            {fmtDate(item.date)}
            <span class="ru-badge">{item.label}</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</WidgetLayout>

<style>
  .ru-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.375rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .ru-item:hover {
    background-color: var(--btn-plain-bg-hover);
  }
  :root.dark .ru-item:hover {
    background-color: oklch(0.16 0 0);
  }
  .ru-item + .ru-item {
    border-top: 1px solid var(--line-divider);
  }

  .ru-thumb {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, transform 0.2s;
  }
  .ru-item:hover .ru-thumb {
    border-color: var(--primary);
    transform: scale(1.06);
  }
  .ru-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ru-thumb-fallback {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--btn-regular-bg);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ru-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ru-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--deep-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }
  .ru-item:hover .ru-title {
    color: var(--primary);
  }

  .ru-date {
    font-size: 0.625rem;
    color: var(--content-meta);
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .ru-date-icon {
    font-size: 0.6rem;
  }

  .ru-badge {
    margin-left: auto;
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--btn-plain-bg-hover);
    color: var(--primary);
  }
  :root.dark .ru-badge {
    background: oklch(0.2 0 0);
  }
  .ru-item:hover .ru-badge {
    background: var(--primary);
    color: var(--page-bg);
  }
  :root.dark .ru-item:hover .ru-badge {
    background: #fff;
    color: #000;
  }
</style>