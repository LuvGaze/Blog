---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
---

<WidgetLayout
	name="天气预报"
	showTitle={showTitle}
	id="weather-widget"
	isCollapsed={true}
	collapsedHeight="8.5rem"
	class={className}
	style={style}
>
	<div data-weather-init class="weather-root">
		<!-- 加载状态 -->
		<div class="w-loading" data-weather-loading>
			<Icon is:inline name="material-symbols:cloud-outline" class="w-loading-icon" />
			<span class="w-loading-text">获取天气中...</span>
		</div>

		<!-- 错误状态 -->
		<div class="w-error hidden" data-weather-error>
			<Icon is:inline name="material-symbols:cloud-off-outline-rounded" class="w-error-icon" />
			<span class="w-error-text" data-error-message>加载失败</span>
			<button class="w-retry-btn" data-retry-btn type="button">点击重试</button>
		</div>

		<!-- 天气内容 -->
		<div class="w-content hidden" data-weather-content>
			<!-- 当前天气主区域 -->
			<div class="w-current">
				<div class="w-current-info">
					<div class="w-location">
						<Icon is:inline name="material-symbols:location-on-rounded" class="w-location-icon" />
						<span class="w-location-text" data-city>--</span>
					</div>
					<div class="w-temp-row">
						<span class="w-temp" data-temperature>--</span>
						<span class="w-temp-unit">°C</span>
					</div>
					<span class="w-desc" data-weather-desc>--</span>
				</div>
				<div class="w-current-right">
					<span class="w-weather-icon" data-weather-icon>☀</span>
					<span class="w-feels"><span class="w-feels-label">体感</span> <span data-feels-like>--</span>°</span>
				</div>
			</div>

			<!-- 高低温 + 更新时间 -->
			<div class="w-meta-row">
				<div class="w-temp-range">
					<span class="w-high">
						<Icon is:inline name="material-symbols:arrow-upward-rounded" class="w-arrow-icon" />
						<span data-temp-max>--</span>°
					</span>
					<span class="w-low">
						<Icon is:inline name="material-symbols:arrow-downward-rounded" class="w-arrow-icon" />
						<span data-temp-min>--</span>°
					</span>
				</div>
				<span class="w-update-time" data-observed-time></span>
			</div>

			<!-- 分割线 -->
			<div class="w-divider"></div>

			<!-- 逐时预报 -->
			<div class="w-section">
				<div class="w-section-title">
					<Icon is:inline name="material-symbols:schedule-outline-rounded" class="w-section-icon" />
					<span>逐时预报</span>
				</div>
				<div class="w-hourly-scroll" data-hourly-scroll></div>
			</div>

			<!-- 每日预报 -->
			<div class="w-section">
				<div class="w-section-title">
					<Icon is:inline name="material-symbols:calendar-month-outline-rounded" class="w-section-icon" />
					<span>未来天气</span>
				</div>
				<div class="w-daily-list" data-daily-list></div>
			</div>

			<!-- 详情网格 -->
			<div class="w-detail-grid">
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:humidity-percentage-outline-rounded" class="w-detail-icon" />
					<span class="w-detail-label">湿度</span>
					<span class="w-detail-value" data-humidity>--%</span>
				</div>
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:air-rounded" class="w-detail-icon" />
					<span class="w-detail-label">风速</span>
					<span class="w-detail-value" data-wind>--</span>
				</div>
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:visibility-outline-rounded" class="w-detail-icon" />
					<span class="w-detail-label">能见度</span>
					<span class="w-detail-value" data-visibility>--</span>
				</div>
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:light-mode-outline-rounded" class="w-detail-icon" />
					<span class="w-detail-label">紫外线</span>
					<span class="w-detail-value" data-uv>--</span>
				</div>
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:compress-rounded" class="w-detail-icon" />
					<span class="w-detail-label">气压</span>
					<span class="w-detail-value" data-pressure>--</span>
				</div>
				<div class="w-detail-item">
					<Icon is:inline name="material-symbols:cloud-outline" class="w-detail-icon" />
					<span class="w-detail-label">云量</span>
					<span class="w-detail-value" data-cloud>--%</span>
				</div>
			</div>

			<!-- 日出日落 -->
			<div class="w-sun-row">
				<div class="w-sun-item">
					<Icon is:inline name="material-symbols:wb-sunny-outline-rounded" class="w-sun-icon w-sunrise-icon" />
					<div class="w-sun-info">
						<span class="w-sun-label">日出</span>
						<span class="w-sun-time" data-sunrise>--:--</span>
					</div>
				</div>
				<div class="w-sun-line"></div>
				<div class="w-sun-item">
					<div class="w-sun-info w-sun-info-right">
						<span class="w-sun-label">日落</span>
						<span class="w-sun-time" data-sunset>--:--</span>
					</div>
					<Icon is:inline name="material-symbols:nightlight-outline-rounded" class="w-sun-icon w-sunset-icon" />
				</div>
			</div>
		</div>
	</div>
</WidgetLayout>

<style is:global>
	/* 天气组件 —— 完全复刻 jerrynis.com（Weather.eDhtqyIv.css） */
	.weather-root {
		width: 100%;
	}

	.weather-root .hidden {
		display: none !important;
	}

	:root.dark .w-temp,
	:root.dark .w-desc,
	:root.dark .w-daily-day,
	:root.dark .w-hourly-temp,
	:root.dark .w-detail-value,
	:root.dark .w-sun-time {
		color: #ffffffe6;
	}

	.w-loading {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 2rem 0;
	}

	.w-loading-icon {
		font-size: 1.75rem;
		color: var(--primary);
		opacity: 0.6;
		animation: w-pulse 1.5s ease-in-out infinite;
	}

	.w-loading-text {
		font-size: 0.75rem;
		color: var(--content-meta);
	}

	@keyframes w-pulse {
		0%,
		100% {
			opacity: 0.4;
		}
		50% {
			opacity: 0.8;
		}
	}

	.w-error {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1.5rem 0;
	}

	.w-error-icon {
		font-size: 1.5rem;
		color: var(--content-meta);
	}

	.w-error-text {
		font-size: 0.75rem;
		color: var(--content-meta);
	}

	.w-retry-btn {
		font-size: 0.75rem;
		color: var(--primary);
		background: none;
		border: none;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.w-retry-btn:hover {
		opacity: 0.7;
		text-decoration: underline;
	}

	.w-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.w-current {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.w-current-info {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}

	.w-location {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--content-meta);
	}

	.w-location-icon {
		font-size: 0.875rem;
	}

	.w-location-text {
		font-size: 0.75rem;
		font-weight: 500;
	}

	.w-temp-row {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.w-temp {
		font-size: 2.25rem;
		font-weight: 700;
		color: var(--deep-text);
		line-height: 1.1;
	}

	.w-temp-unit {
		font-size: 1rem;
		color: var(--content-meta);
	}

	.w-desc {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--deep-text);
	}

	.w-current-right {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		flex-shrink: 0;
	}

	.w-weather-icon {
		font-size: 2rem;
		font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
		line-height: 1;
	}

	.w-feels {
		font-size: 0.7rem;
		color: var(--content-meta);
		white-space: nowrap;
	}

	.w-meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.7rem;
	}

	.w-temp-range {
		display: flex;
		gap: 0.6rem;
	}

	.w-high {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		color: #ef4444;
		font-weight: 500;
	}

	.w-low {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		color: #3b82f6;
		font-weight: 500;
	}

	.w-arrow-icon {
		font-size: 0.875rem;
	}

	.w-update-time {
		color: var(--content-meta);
	}

	.w-divider {
		height: 1px;
		background: var(--line-divider);
	}

	.w-section {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.w-section-title {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--content-meta);
		font-size: 0.7rem;
		font-weight: 500;
	}

	.w-section-icon {
		font-size: 0.875rem;
	}

	.w-hourly-scroll {
		display: flex;
		gap: 0.25rem;
		overflow-x: auto;
		padding-bottom: 0.25rem;
		scroll-behavior: smooth;
		scrollbar-width: thin;
	}

	.w-hourly-scroll::-webkit-scrollbar {
		height: 3px;
	}

	.w-hourly-scroll::-webkit-scrollbar-thumb {
		background: var(--line-divider);
		border-radius: 2px;
	}

	.w-hourly-item {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		padding: 0.3rem 0.4rem;
		border-radius: 0.5rem;
		min-width: 2.5rem;
		transition: background 0.2s ease;
	}

	.w-hourly-item:hover {
		background: var(--btn-plain-bg-hover);
	}

	.w-hourly-item.active {
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}

	.w-hourly-time {
		font-size: 0.65rem;
		color: var(--content-meta);
	}

	.w-hourly-icon {
		font-size: 1.1rem;
		font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
		line-height: 1;
	}

	.w-hourly-temp {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--deep-text);
	}

	.w-daily-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.w-daily-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.4rem;
		border-radius: 0.5rem;
		transition: background 0.2s ease;
	}

	.w-daily-row:hover {
		background: var(--btn-plain-bg-hover);
	}

	.w-daily-day {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--deep-text);
		min-width: 2.5rem;
	}

	.w-daily-icon {
		font-size: 1.1rem;
		font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
		line-height: 1;
	}

	.w-daily-desc {
		font-size: 0.65rem;
		color: var(--content-meta);
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.w-daily-high {
		font-size: 0.7rem;
		font-weight: 500;
		color: #ef4444;
	}

	.w-daily-low {
		font-size: 0.7rem;
		font-weight: 500;
		color: #3b82f6;
	}

	.w-detail-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem;
	}

	.w-detail-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		padding: 0.5rem 0.25rem;
		border-radius: 0.5rem;
		background: var(--btn-plain-bg-hover);
		transition: background 0.2s ease;
	}

	.w-detail-item:hover {
		background: var(--muted);
	}

	.w-detail-icon {
		font-size: 1rem;
		color: var(--primary);
	}

	.w-detail-label {
		font-size: 0.65rem;
		color: var(--content-meta);
	}

	.w-detail-value {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--deep-text);
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.w-sun-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		background: var(--btn-plain-bg-hover);
		margin-bottom: 0.5rem;
	}

	.w-sun-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.w-sun-info {
		display: flex;
		flex-direction: column;
	}

	.w-sun-info-right {
		align-items: flex-end;
	}

	.w-sun-icon {
		font-size: 1rem;
	}

	.w-sunrise-icon {
		color: #f59e0b;
	}

	.w-sunset-icon {
		color: #6366f1;
	}

	.w-sun-label {
		font-size: 0.65rem;
		color: var(--content-meta);
	}

	.w-sun-time {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--deep-text);
	}

	.w-sun-line {
		flex: 1;
		height: 1px;
		background: var(--line-divider);
		margin: 0 0.75rem;
	}
</style>

<script is:inline>
(function () {
  var API_BASE = "https://uapis.cn/api/v1/misc/weather";
  var CACHE_KEY = "__weatherCache_v7";
  var TTL = 30 * 60 * 1000;
  var inFlight = null;

  var SYMBOLS = [
    [/雷|闪电|storm|thunder/i, "⛈️"],
    [/暴雨|大雨|heavy/i, "🌧️"],
    [/雨夹雪|sleet/i, "🌨️"],
    [/小雪|中雪|大雪|雪|snow/i, "❄️"],
    [/雾|fog|mist/i, "🌫️"],
    [/霾|haze|smog/i, "😷"],
    [/沙|尘|sand/i, "💨"],
    [/风|wind/i, "💨"],
    [/雨|rain|shower/i, "🌦️"],
    [/阴|overcast/i, "☁️"],
    [/多云|partly/i, "⛅"],
    [/晴|clear|sun/i, "☀️"]
  ];

  var WEEK = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];

  function iconOf(desc) {
    var text = String(desc || "");
    for (var i = 0; i < SYMBOLS.length; i++) {
      if (SYMBOLS[i][0].test(text)) return SYMBOLS[i][1];
    }
    return "🌤️";
  }

  function pad(n) { return n < 10 ? "0" + n : "" + n; }

  function formatTime(value) {
    if (!value) return "--:--";
    if (/^\d{2}:\d{2}$/.test(String(value))) return value;
    var d = new Date(value);
    if (isNaN(d.getTime())) return "--:--";
    return pad(d.getHours()) + ":" + pad(d.getMinutes());
  }

  function formatHour(value) {
    if (!value) return "";
    var d = new Date(String(value).replace(/-/g, "/"));
    if (isNaN(d.getTime())) return "";
    return pad(d.getHours()) + ":00";
  }

  function formatVisibility(value) {
    if (value == null) return "--";
    return value + "km";
  }

  function uvLevel(uv) {
    if (uv == null) return "--";
    if (uv < 3) return uv.toFixed(1) + " 低";
    if (uv < 6) return uv.toFixed(1) + " 中";
    if (uv < 8) return uv.toFixed(1) + " 高";
    if (uv < 11) return uv.toFixed(1) + " 甚高";
    return uv.toFixed(1) + " 极高";
  }

  function dayName(dateStr, index) {
    if (index === 0) return "今天";
    if (index === 1) return "明天";
    if (index === 2) return "后天";
    var d = new Date(String(dateStr).replace(/-/g, "/"));
    if (isNaN(d.getTime())) return "--";
    return WEEK[d.getDay()];
  }

  function readCache() {
    try {
      var raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      if (Date.now() - parsed.timestamp < TTL) return parsed.data;
    } catch (e) {}
    return null;
  }

  function writeCache(data) {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({ data: data, timestamp: Date.now() }));
    } catch (e) {}
  }

  function fetchWeather() {
    var cached = readCache();
    if (cached) return Promise.resolve(cached);
    if (inFlight) return inFlight;
    var url = API_BASE + "?extended=true&forecast=true&hourly=true&minutely=false&lang=zh";
    inFlight = fetch(url)
      .then(function (res) {
        if (!res.ok) throw new Error("请求失败: " + res.status);
        return res.json();
      })
      .then(function (data) {
        if (!data || !data.weather) throw new Error("天气数据获取失败");
        data._fetchedAt = Date.now();
        writeCache(data);
        return data;
      })
      .catch(function (err) {
        throw err;
      })
      .finally(function () {
        inFlight = null;
      });
    return inFlight;
  }

  function updateUI(container, data) {
    var loading = container.querySelector("[data-weather-loading]");
    var errorEl = container.querySelector("[data-weather-error]");
    var content = container.querySelector("[data-weather-content]");
    if (!loading || !errorEl || !content) return;
    loading.classList.add("hidden");
    errorEl.classList.add("hidden");

    var cur = data || {};
    var daily = cur.forecast || [];
    var hourly = cur.hourly_forecast || [];

    container.querySelector("[data-city]").textContent =
      cur.city || cur.district || cur.province || "--";
    container.querySelector("[data-temperature]").textContent =
      cur.temperature != null ? Math.round(cur.temperature) : "--";
    container.querySelector("[data-feels-like]").textContent =
      cur.feels_like != null ? Math.round(cur.feels_like) : "--";
    container.querySelector("[data-weather-desc]").textContent = cur.weather || "--";
    container.querySelector("[data-weather-icon]").textContent = iconOf(cur.weather);

    var observedEl = container.querySelector("[data-observed-time]");
    observedEl.textContent = cur._fetchedAt
      ? formatTime(cur._fetchedAt) + " 更新"
      : (cur.report_time || "");

    var maxEl = container.querySelector("[data-temp-max]");
    var minEl = container.querySelector("[data-temp-min]");
    maxEl.textContent = cur.temp_max != null ? Math.round(cur.temp_max) : (daily[0] ? Math.round(daily[0].temp_max) : "--");
    minEl.textContent = cur.temp_min != null ? Math.round(cur.temp_min) : (daily[0] ? Math.round(daily[0].temp_min) : "--");

    // 逐时预报：从当前时间起取 12 小时
    var hourlyScroll = container.querySelector("[data-hourly-scroll]");
    hourlyScroll.innerHTML = "";
    var now = new Date();
    var upcoming = hourly.filter(function (h) {
      var t = new Date(String(h.time || "").replace(/-/g, "/"));
      return !isNaN(t.getTime()) && t >= now;
    });
    if (!upcoming.length) upcoming = hourly.slice(0, 12);
    upcoming.slice(0, 12).forEach(function (h, i) {
      var el = document.createElement("div");
      el.className = "w-hourly-item" + (i === 0 ? " active" : "");
      el.innerHTML =
        '<span class="w-hourly-time">' + (i === 0 ? "现在" : formatHour(h.time)) + "</span>" +
        '<span class="w-hourly-icon">' + iconOf(h.weather) + "</span>" +
        '<span class="w-hourly-temp">' + (h.temperature != null ? Math.round(h.temperature) : "--") + "°</span>";
      hourlyScroll.appendChild(el);
    });

    // 未来天气：3 天
    var dailyList = container.querySelector("[data-daily-list]");
    dailyList.innerHTML = "";
    daily.slice(0, 3).forEach(function (d, i) {
      var el = document.createElement("div");
      el.className = "w-daily-row";
      el.innerHTML =
        '<span class="w-daily-day">' + dayName(d.date, i) + "</span>" +
        '<span class="w-daily-icon">' + iconOf(d.weather_day) + "</span>" +
        '<span class="w-daily-desc">' + (d.weather_day || "--") + "</span>" +
        '<span class="w-daily-high">' + Math.round(d.temp_max) + "°</span>" +
        '<span class="w-daily-low">' + Math.round(d.temp_min) + "°</span>";
      dailyList.appendChild(el);
    });

    container.querySelector("[data-humidity]").textContent =
      cur.humidity != null ? cur.humidity + "%" : "--%";
    container.querySelector("[data-wind]").textContent =
      [cur.wind_direction, cur.wind_power].filter(Boolean).join(" ") || "--";
    container.querySelector("[data-visibility]").textContent = formatVisibility(cur.visibility);
    container.querySelector("[data-uv]").textContent = uvLevel(cur.uv);
    container.querySelector("[data-pressure]").textContent =
      cur.pressure != null ? Math.round(cur.pressure) : "--";
    container.querySelector("[data-cloud]").textContent =
      cur.cloud != null ? cur.cloud + "%" : "--%";

    if (daily[0]) {
      container.querySelector("[data-sunrise]").textContent = formatTime(daily[0].sunrise);
      container.querySelector("[data-sunset]").textContent = formatTime(daily[0].sunset);
    }

    content.classList.remove("hidden");
  }

  function showError(container, msg) {
    var loading = container.querySelector("[data-weather-loading]");
    var errorEl = container.querySelector("[data-weather-error]");
    var errorMsg = container.querySelector("[data-error-message]");
    loading.classList.add("hidden");
    errorEl.classList.remove("hidden");
    if (errorMsg) errorMsg.textContent = msg || "获取天气失败";
  }

  function initWidget(container) {
    if (container.dataset.weatherReady === "true") return;
    container.dataset.weatherReady = "true";

    var retryBtn = container.querySelector("[data-retry-btn]");

    function load() {
      var loading = container.querySelector("[data-weather-loading]");
      var errorEl = container.querySelector("[data-weather-error]");
      var content = container.querySelector("[data-weather-content]");
      loading.classList.remove("hidden");
      errorEl.classList.add("hidden");
      content.classList.add("hidden");
      fetchWeather()
        .then(function (data) {
          container.__weatherData = data;
          updateUI(container, data);
        })
        .catch(function (err) {
          showError(container, err && err.message);
        });
    }

    if (retryBtn) {
      retryBtn.addEventListener("click", function () {
        try {
          Object.keys(localStorage).forEach(function (key) {
            if (key.indexOf(CACHE_KEY) === 0) localStorage.removeItem(key);
          });
        } catch (e) {}
        load();
      });
    }

    load();
  }

  function initAll() {
    document.querySelectorAll("[data-weather-init]").forEach(initWidget);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initAll);
  else initAll();
  document.addEventListener("swup:contentReplaced", function () { setTimeout(initAll, 50); });
})();
</script>
