---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

const pStyle = profileConfig.style ?? {};

// 头像尺寸 / 圆角（默认直径 4rem 圆形）
const avatarWidth = pStyle.avatarWidth ?? "4rem";
const avatarHeight = pStyle.avatarWidth ?? "4rem";
const avatarRadius = pStyle.avatarRadius ?? "50%";

// 昵称 / 简介字号
const nameSize = pStyle.nameSize ?? "1.25rem";
const bioSize = pStyle.bioSize ?? "0.875rem";

// 背景图
const hasBg = !!pStyle.backgroundImage;
const bgOpacity = pStyle.backgroundOpacity ?? 1;
---
<div class:list={["card-base", "p-3", "relative", "overflow-hidden", className]} style={style}>
  <!-- 顶部背景图（可选），参照参考模板 profile 卡片的背景条 -->
  {hasBg && (
    <>
      <div class="profile-bg absolute inset-x-0 top-0" style={`opacity: ${bgOpacity};`}>
        <ImageWrapper
          src={pStyle.backgroundImage || ""}
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          widths={[400]}
          sizes="400px"
        />
      </div>
      <div class="profile-bg-fade absolute inset-x-0 bottom-0"></div>
    </>
  )}

  <!-- 头像（居中，可跨背景和内容区） -->
  <div class="relative z-2 flex justify-center" style={hasBg ? "margin-top: -0.75rem;" : undefined}>
    <a
      aria-label="Go to About Page"
      href={url("/about/")}
      class="group block relative m-auto mt-1 mb-3 overflow-hidden active:scale-95"
      style={`width: ${avatarWidth}; height: ${avatarHeight}; border-radius: ${avatarRadius}; box-shadow: 0 2px 12px rgba(0,0,0,0.2);`}
    >
      <div
        class="absolute inset-0 z-50 flex items-center justify-center transition pointer-events-none group-hover:bg-black/30 group-hover:opacity-100 opacity-0"
      >
        <Icon is:inline
          name="fa7-regular:address-card"
          class="text-white text-5xl"
        />
      </div>
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt="Profile Image of the Author"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[160]}
        sizes="160px"
      />
    </a>
  </div>

  <div class="px-2 text-center">
    <div
      class="font-bold mb-1 dark:text-neutral-50 transition"
      style={`font-size: ${nameSize};`}
    >
      {profileConfig.name}
    </div>
    <div class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"></div>
    <div class="text-neutral-400 mb-2.5 transition" style={`font-size: ${bioSize};`}>
      {profileConfig.bio}
    </div>

    <div class="flex flex-wrap gap-2 justify-center mb-1">
      {profileConfig.links.filter(item => item && item.url).length > 1 && profileConfig.links.filter(item => item && item.url).map(item =>
        {
        const showName = item.showName;
        const linkClass = showName
            ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95"
            : "btn-regular rounded-lg h-10 w-10 active:scale-90";

        if (item.url.startsWith("mailto:")) {
            const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
            return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                (function() {
                                    const encodedEmail = this.getAttribute('data-encoded-email');
                                    const decodedEmail = atob(encodedEmail);
                                    this.href = 'mailto:' + decodedEmail;
                                    this.removeAttribute('data-encoded-email');
                                    this.removeAttribute('onclick');
                                    this.click();
                                    return false;
                                }).call(this);
                            `.replace(/\s+/g, " ").trim()
                        },
                        class={linkClass}>
                    <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                    {showName && item.name}
                </a>
        } else {
            return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={linkClass}>
                <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                {showName && item.name}
            </a>
        }
        }
      )}
      {profileConfig.links.filter(item => item && item.url).length == 1 && (function(item){
        if (item.url.startsWith("mailto:")) {
                const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                    (function() {
                                        const encodedEmail = this.getAttribute('data-encoded-email');
                                        const decodedEmail = atob(encodedEmail);
                                        this.href = 'mailto:' + decodedEmail;
                                        this.removeAttribute('data-encoded-email');
                                        this.removeAttribute('onclick');
                                        this.click();
                                        return false;
                                    }).call(this);
                                `.replace(/\s+/g, " ").trim()
                            },
                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                    <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                    {item.name}
                </a>
        } else {
            return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
        }
      })(profileConfig.links[0])}
    </div>
  </div>
</div>

<style is:global>
  .profile-bg {
    height: 7rem;
    z-index: 0;
  }
  .profile-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile-bg-fade {
    height: 3rem;
    z-index: 1;
    background: linear-gradient(to bottom, transparent, var(--card-bg, #fff));
  }
  :root.dark .profile-bg-fade {
    background: linear-gradient(to bottom, transparent, var(--card-bg, #181818));
  }
</style>