---
interface FlowEntry {
	cat: string;
	desc: string;
	time: string;
	amount: number;
	type: string;
}
interface FlowDay {
	key: string;
	label: string;
	income: number;
	expense: number;
	entries: FlowEntry[];
}
interface FlowMonth {
	key: string;
	label: string;
	days: FlowDay[];
}
interface Props {
	months: FlowMonth[];
	currentMonth: string;
}
const { months, currentMonth } = Astro.props;
const fmt = (n: number) => n.toFixed(2);
const icons: Record<string, string> = {
	餐饮: "🍜",
	交通: "🚌",
	购物: "🛍️",
	居家生活: "🏠",
	交流通讯: "📡",
	食品酒水: "🥧",
	住房: "🏠",
	工资: "💼",
	职业收入: "💼",
	人情收礼: "🧧",
	人情往来: "🧧",
	学习办公: "📝",
	医疗: "💊",
	娱乐: "🎤",
	还款: "💳",
	期初余额: "🏦",
	其他: "📌",
};
---
<div class="flow-card" data-flow-card data-current-month={currentMonth}>
  <div class="flow-head">
    <h3 class="flow-title">本月流水</h3>
    <div class="flow-head-right">
      <div class="flow-types" aria-label="筛选类型">
        <button type="button" class="ftype is-active" data-type="all">全部</button>
        <button type="button" class="ftype" data-type="expense">支出</button>
        <button type="button" class="ftype" data-type="income">收入</button>
      </div>
      <select class="flow-month-select" aria-label="筛选月份">
        {months.map((m) => (
          <option value={m.key} selected={m.key === currentMonth}>{m.label}</option>
        ))}
      </select>
    </div>
  </div>
  {months.map((m) => (
    <div class="flow-month" data-month-block={m.key} hidden={m.key !== currentMonth}>
      {m.days.length === 0 ? (
        <p class="flow-empty">这个月还没有记账</p>
      ) : (
        m.days.map((day) => (
          <div class="flow-day" data-day>
            <div class="flow-day-head">
              <span class="flow-day-date">{day.label}</span>
              <span class="flow-day-sum">支 ¥{fmt(day.expense)} 收 ¥{fmt(day.income)}</span>
            </div>
            <div class="flow-entries">
              {day.entries.map((e) => (
                <span class="flow-entry" data-type={e.type}>
                  <span class="fe-ico" aria-hidden="true">{icons[e.cat] ?? "🧾"}</span>
                  <span class="fe-cat">{e.cat}{e.desc && e.desc !== e.cat ? ` · ${e.desc}` : ""}</span>
                  <b class="fe-amt">{e.type === "income" ? "+" : "-"}{fmt(Math.abs(e.amount))}</b>
                </span>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  ))}
</div>
<script is:inline>
(function(){
  function init(root){
    if(!root || root.dataset.flowInit === "1") return;
    root.dataset.flowInit = "1";
    var select = root.querySelector('.flow-month-select');
    var title = root.querySelector('.flow-title');
    var ftypeBtns = Array.from(root.querySelectorAll('.ftype'));
    var currentMonth = root.dataset.currentMonth || "";
    var activeType = 'all';

    function visibleType(el){
      return activeType === 'all' || el.dataset.type === activeType;
    }

    function applyDayVisibility(monthEl){
      monthEl.querySelectorAll('[data-day]').forEach(function(day){
        var entries = Array.from(day.querySelectorAll('.flow-entry'));
        var none = entries.every(function(e){ return !visibleType(e); });
        day.style.display = none ? 'none' : '';
        if(!none){
          entries.forEach(function(e){ e.style.display = visibleType(e) ? '' : 'none'; });
        }
      });
    }

    function apply(){
      var month = select.value;
      root.querySelectorAll('[data-month-block]').forEach(function(el){
        el.hidden = el.dataset.monthBlock !== month;
        if(el.dataset.monthBlock === month) applyDayVisibility(el);
      });
      if(title){
        var opt = select.selectedOptions[0];
        title.textContent = month === currentMonth ? '本月流水' : (opt ? opt.textContent : '') + '流水';
      }
    }

    select.addEventListener('change', function(){
      apply();
      document.dispatchEvent(new CustomEvent('bills:month-change', { detail: { month: select.value } }));
    });

    ftypeBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        activeType = btn.dataset.type;
        ftypeBtns.forEach(function(b){ b.classList.toggle('is-active', b === btn); });
        root.querySelectorAll('[data-month-block]:not([hidden])').forEach(applyDayVisibility);
      });
    });

    apply();
  }
  function scan(){ document.querySelectorAll('[data-flow-card]').forEach(init); }
  scan();
  document.addEventListener('swup:content:replaced', scan);
})();
</script>
<style>
@reference "../../styles/main.css";
.flow-card{ background:var(--card-bg); border:1px solid var(--line-divider); border-radius:0.75rem; padding:0.8rem 0.95rem; }
.flow-head{ display:flex; align-items:center; justify-content:space-between; gap:0.6rem; margin-bottom:0.5rem; flex-wrap:wrap; }
.flow-title{ font-size:0.82rem; font-weight:700; margin:0; color: var(--deep-text); }
.flow-head-right{ display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; }
.flow-types{ display:flex; gap:0.2rem; background:var(--line-divider); border-radius:9999px; padding:0.16rem; }
.ftype{ border:none; background:transparent; color:var(--content-meta); font-size:0.66rem; padding:0.2rem 0.6rem; border-radius:9999px; cursor:pointer; line-height:1.3; }
.ftype:hover{ color:var(--deep-text); }
.ftype.is-active{ background:var(--card-bg); color:var(--deep-text); font-weight:600; box-shadow:0 1px 4px oklch(0 0 0 / 0.1); }
.flow-month-select{ font-size:0.68rem; color:var(--deep-text); background:var(--card-bg); border:1px solid var(--line-divider); border-radius:0.4rem; padding:0.2rem 0.4rem; cursor:pointer; }
.flow-day{ padding:0.4rem 0; border-bottom:1px solid var(--line-divider); }
.flow-day:last-child{ border-bottom:none; }
.flow-day-head{ display:flex; align-items:baseline; justify-content:space-between; gap:0.6rem; margin-bottom:0.28rem; }
.flow-day-date{ font-size:0.72rem; font-weight:700; color: var(--deep-text); }
.flow-day-sum{ font-size:0.62rem; color: var(--content-meta); white-space:nowrap; font-variant-numeric:tabular-nums; }
.flow-entries{ display:flex; flex-wrap:wrap; gap:0.32rem; }
.flow-entry{ display:inline-flex; align-items:center; gap:0.28rem; font-size:0.66rem; padding:0.16rem 0.55rem; border-radius:0.4rem; border:1px solid var(--line-divider); background:color-mix(in oklab, var(--card-bg) 80%, var(--primary) 5%); color: var(--deep-text); line-height:1.25; cursor:default; }
.flow-entry[data-type="expense"] .fe-amt{ color:#0e7490; }
.flow-entry[data-type="income"] .fe-amt{ color:#ef4444; }
.fe-ico{ font-size:0.72rem; }
.fe-cat{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:14rem; }
.fe-amt{ font-variant-numeric:tabular-nums; white-space:nowrap; }
.flow-empty{ margin:0.4rem 0; padding:0.6rem 0; text-align:center; font-size:0.74rem; color: var(--content-meta); }
</style>