---
interface Props {
	income: number;
	expense: number;
	balance: number;
}
const { income, expense, balance } = Astro.props;
const fmt = (n: number) => n.toFixed(2);
---
<div class="monthly-card">
  <div class="monthly-content">
    <div class="monthly-label">本月收支情况</div>
    <div class="monthly-value">
      <span class="monthly-num">{fmt(balance)}</span>
      <span class="monthly-eye" aria-hidden="true">◉</span>
    </div>
    <div class="monthly-sub">
      <span>收入 {fmt(income)}</span>
      <span class="monthly-divider">|</span>
      <span>支出 {fmt(expense)}</span>
    </div>
  </div>
</div>
<style>
@reference "../../styles/main.css";
.monthly-card{ position:relative; height:10.2rem; border-radius:0.75rem; overflow:hidden; border:1px solid var(--line-divider); background-image:
  linear-gradient(225deg, color-mix(in oklab, var(--card-bg) 86%, transparent) 0%, color-mix(in oklab, var(--card-bg) 40%, transparent) 100%),
  url("https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=a%20bright%20airy%20abstract%20background%20with%20soft%20warm%20orange%20and%20peach%20gradient%20glow%2C%20high%20key%2C%20clean%20minimal%2C%20no%20text&image_size=landscape_16_9");
  background-size: cover, cover;
  background-position: center; }
.monthly-content{ position:relative; z-index:1; height:100%; display:flex; flex-direction:column; justify-content:center; gap:0.35rem; padding:1.1rem 1.2rem; color: var(--deep-text); }
.monthly-label{ font-size:0.72rem; color: var(--content-meta); }
.monthly-value{ display:flex; align-items:center; gap:0.45rem; line-height:1; }
.monthly-num{ font-size:1.9rem; font-weight:800; letter-spacing:-0.02em; line-height:1.1; }
.monthly-eye{ font-size:0.95rem; opacity:0.55; }
.monthly-sub{ display:flex; align-items:center; gap:0.5rem; font-size:0.7rem; color: var(--content-meta); margin-top:0.15rem; }
.monthly-divider{ opacity:0.5; }
@media(max-width:768px){
  .monthly-card{ height:9rem; }
  .monthly-num{ font-size:1.6rem; }
}
</style>
