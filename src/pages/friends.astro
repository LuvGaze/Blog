---
import { getCollection, getEntry, render } from "astro:content";
import { domainToUnicode } from "node:url";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import FriendCard from "@components/features/FriendCard.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { circleConfig } from "@/config/circleConfig";
import "@/styles/features/circle.css";

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 从 content/friends 目录读取友链数据，按权重排序
const friendsEntries = await getCollection("friends");
const items = friendsEntries
	.filter((item) => item.data.enabled !== false)
	.sort((a, b) => (b.data.weight || 0) - (a.data.weight || 0));

// 新朋友：按添加日期（added）降序取最近 3 个。
// 禁止用文件 mtime 兜底：CI 全新 clone 时所有文件 mtime 都等于构建时刻，
// 会让缺 added 的旧友链永远霸占"新朋友"区块（2026-09 线上事故根因）
const missingAdded = items.filter((item) => !item.data.added);
if (missingAdded.length > 0) {
	console.warn(
		`[friends] ${missingAdded.length} 个友链缺少 added 字段，不参与"新朋友"排序：${missingAdded.map((item) => item.id).join("、")}`,
	);
}
const latestItems = [...items]
	.sort(
		(a, b) => (b.data.added?.getTime() ?? 0) - (a.data.added?.getTime() ?? 0),
	)
	.slice(0, 3);

// 友链数量不超过「新朋友」上限时，独立区块会把所有友链掏空、导致分组不可见；
// 这种情况直接按分组展示全部友链
const showLatest = items.length > latestItems.length;

// 新朋友区块独立展示后，从分组中排除，避免同一站点出现两次
const latestIds = new Set(showLatest ? latestItems.map((item) => item.id) : []);

 // 内容 id 形如「好盆友/站点名」，第一段即分组文件夹名
const folderOf = (id: string) => {
	const normalized = id.replace(/\\/g, "/");
	return normalized.includes("/") ? normalized.split("/")[0] : "";
};

 // 自定义分组：读取各分组文件夹的 _index.json（name 即文件夹名），构建 title/description 与排序
const groupEntries = await getCollection("friendGroups");
const groupDefs: Record<string, { title: string; description?: string; sort: number }> = {};
const definedKeys = new Set<string>();
groupEntries.forEach((entry) => {
	const def = entry.data;
	const key = folderOf(entry.id) || def.name;
	groupDefs[key] = {
		title: def.title ?? def.name,
		description: def.description,
		sort: def.sort ?? 0,
	};
	definedKeys.add(key);
});

// 其余友链按分组文件夹聚成多个小节（分组信息全部来自文件夹与 _index.json）
const rest = items.filter((item) => !latestIds.has(item.id));
const byKey = new Map<string, typeof rest>();
rest.forEach((item) => {
	const key = folderOf(item.id) || "未分组";
	if (!byKey.has(key)) byKey.set(key, []);
	byKey.get(key)!.push(item);
});
// 分组顺序：已定义分组按 sort 降序，未定义分组按 key 字母序排在最后
const groups = [...byKey.entries()]
	.sort((a, b) => {
		const aDef = definedKeys.has(a[0]);
		const bDef = definedKeys.has(b[0]);
		if (aDef !== bDef) return aDef ? -1 : 1;
		if (aDef) return (groupDefs[b[0]].sort) - (groupDefs[a[0]].sort);
		return a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0;
	})
	.map(([key, friends]) => ({ key, friends }));

// 域名（还原为 Unicode 显示，避免 IDN 域名显示成 xn-- punycode；取不到时回退空串）
const hostOf = (siteurl: string) => {
	try {
		const url = new URL(siteurl);
		const hostname = domainToUnicode(url.hostname);
		return url.port ? `${hostname}:${url.port}` : hostname;
	} catch {
		return "";
	}
};

// 页面标题和描述
const title = i18n(I18nKey.friends);
const description = i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) relative min-h-32"
  >
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <Icon name="material-symbols:group" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
            <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {title}
            </h1>
          </div>
          <button
            id="btn-add-friend"
            class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-medium hover:opacity-85 transition-opacity cursor-pointer"
          >
            <Icon name="material-symbols:person-add-rounded" class="text-base" />
            添加友链
          </button>
        </div>
        {
          description && (
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              {description}
            </p>
          )
        }
      </div>

      <!-- 视图切换：友链 / 全部动态 -->
      <div class="friend-tabs" role="tablist" aria-label="友链与动态">
        <button class="friend-tab is-active" type="button" role="tab" aria-selected="true" data-friends-tab="list">友链</button>
        <button class="friend-tab" type="button" role="tab" aria-selected="false" data-friends-tab="feed">
          全部动态
          <span class="friend-tab-badge" data-feed-count hidden>0</span>
        </button>
      </div>

      <div class="friend-list-panel" data-friends-panel="list">
      <!-- 新朋友：最近添加的 3 个 -->
      {
        showLatest && latestItems.length > 0 && (
          <section class="friend-section">
            <div class="friend-group-head">
              <div>
                <h2 class="friend-group-title">
                  {i18n(I18nKey.friendsLatestTitle)}
                </h2>
                <p class="friend-group-desc">{i18n(I18nKey.friendsShiningDesc).replace("{n}", String(latestItems.length))}</p>
              </div>
              <span class="friend-group-badge">{latestItems.length} {i18n(I18nKey.friendsSites)}</span>
            </div>
            <div class="friends-grid" data-friends-grid>
              {
                latestItems.map((item) => (
                  <FriendCard
                    title={item.data.title}
                    href={item.data.siteurl}
                    imgurl={item.data.imgurl}
                    desc={item.data.desc}
                    screenshot={item.data.screenshot}
                    host={hostOf(item.data.siteurl)}
                    feedHost={item.data.siteurl}
                  />
                ))
              }
            </div>
          </section>
        )
      }

      <!-- 自定义分组小节：每个分组渲染一个 section -->
      {
        groups.map((group) => (
          <section class="friend-section mt-8">
            <div class="friend-group-head">
              <div>
                <h2 class="friend-group-title">
                  {groupDefs[group.key]?.title ?? group.key}
                </h2>
                {
                  groupDefs[group.key]?.description && (
                    <p class="friend-group-desc">{groupDefs[group.key]!.description}</p>
                  )
                }
              </div>
              <span class="friend-group-badge">{group.friends.length} {i18n(I18nKey.friendsSites)}</span>
            </div>
            <div class="friends-grid" data-friends-grid>
              {
                group.friends.map((item) => (
                  <FriendCard
                    title={item.data.title}
                    href={item.data.siteurl}
                    imgurl={item.data.imgurl}
                    desc={item.data.desc}
                    screenshot={item.data.screenshot}
                    host={hostOf(item.data.siteurl)}
                    feedHost={item.data.siteurl}
                  />
                ))
              }
            </div>
          </section>
        ))
      }

      <Markdown class="mt-2">
        <Content />
      </Markdown>
      </div><!-- /list panel -->

      <!-- 全部动态（推文）：切到该 Tab 时才请求 data.json -->
      <div class="friend-feed-panel" data-friends-panel="feed" hidden>
        <div class="friend-feed-bar">
          <div class="friend-feed-stats">
            <span class="friend-feed-stat">友链 <strong data-feed-stat-friends>0</strong></span>
            <span class="friend-feed-dot">·</span>
            <span class="friend-feed-stat">活跃 <strong data-feed-stat-active>0</strong></span>
            <span class="friend-feed-dot">·</span>
            <span class="friend-feed-stat">文章 <strong data-feed-stat-articles>0</strong></span>
          </div>
          <div class="friend-feed-sorts">
            <button class="friend-feed-sort is-active" type="button" data-feed-sort="created">最新发布</button>
            <button class="friend-feed-sort" type="button" data-feed-sort="updated">最近更新</button>
          </div>
        </div>

        <div class="friend-feed-loading" data-feed-loading>
          <div class="loading-spinner"></div>
          <p>正在钓鱼中…</p>
        </div>

        <div class="friend-feed-state" data-feed-error hidden>
          <p>友链动态暂时没有钓上来</p>
          <button class="friend-feed-retry" type="button" data-feed-retry>重新加载</button>
        </div>

        <div class="friend-feed-state" data-feed-empty hidden>
          <p>还没有抓取到友链的更新</p>
        </div>

        <div class="friend-feed-grid" data-feed-grid hidden></div>

        <div class="friend-feed-more" data-feed-more hidden>
          <button class="friend-feed-more-btn" type="button" data-feed-loadmore>加载更多</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 单友链动态弹层 -->
  <div class="friend-modal" id="friend-feed-modal" hidden>
    <div class="friend-modal-mask" data-friend-modal-close></div>
    <div class="friend-modal-panel" role="dialog" aria-modal="true" aria-labelledby="friend-modal-name">
      <div class="friend-modal-head">
        <img class="friend-modal-avatar" data-friend-modal-avatar alt="" />
        <div class="friend-modal-info">
          <h3 class="friend-modal-name" id="friend-modal-name" data-friend-modal-name></h3>
          <a class="friend-modal-site" data-friend-modal-site target="_blank" rel="noopener noreferrer"></a>
        </div>
        <button class="friend-modal-close" type="button" data-friend-modal-close aria-label="关闭">
          <Icon name="material-symbols:close-rounded" class="text-lg" />
        </button>
      </div>
      <div class="friend-modal-loading" data-friend-modal-loading hidden>
        <div class="loading-spinner"></div>
      </div>
      <div class="friend-modal-state" data-friend-modal-error hidden>动态加载失败，请稍后再试</div>
      <div class="friend-modal-state" data-friend-modal-empty hidden>TA 最近还没有更新</div>
      <div class="friend-feed-grid friend-modal-grid" data-friend-modal-grid></div>
    </div>
  </div>

  <!-- 评论区（负 margin 抵消评论卡片的 p-8 顶部 padding，收紧与上方内容的间距） -->
  <div class="-mt-6">
    <Comment post={friendsPost} customPath="/friends/" />
  </div>

  <!-- "添加友链" 按钮：先切回友链视图，再滚动到评论区 -->
  <script slot="head" is:inline>
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('#btn-add-friend');
      if (!btn) return;
      var listTab = document.querySelector('[data-friends-tab="list"]');
      if (listTab && !listTab.classList.contains('is-active')) listTab.click();
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          var comment = document.querySelector('.comment-container, #post-comments, #waline, #tcomment, .giscus');
          if (comment) { comment.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
      });
    });
  </script>

  <!-- 友链卡片交互（光晕跟随 / 整卡点击 / 头像懒加载 / 状态注入） -->
  <script is:inline>
    (function() {
      if (window.__friendCardReady) return;
      window.__friendCardReady = true;

      /* --- 头像懒加载（data-src → src，失败显示涂鸦） --- */
      function loadAvatar(card) {
        var img = card.querySelector(".friend-card-avatar__img");
        if (!img || img.dataset.avatarLoaded) return;
        img.dataset.avatarLoaded = "1";
        var wrap = img.parentElement;
        var src = img.dataset.src;
        if (!wrap || !src) return;
        var TIMEOUT = 5000;
        var timer = setTimeout(function() {
          if (!wrap.classList.contains("is-loaded")) wrap.classList.add("is-error");
        }, TIMEOUT);
        img.addEventListener("load", function() {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        });
        img.addEventListener("error", function() {
          clearTimeout(timer);
          wrap.classList.add("is-error");
        });
        img.src = src;
        if (img.complete && img.naturalWidth > 0) {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        }
      }

      var io = null;
      function bindAvatarObserver() {
        if (io) io.disconnect();
        var cards = document.querySelectorAll(".friend-card");
        if (!cards.length) return;
        io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting) return;
            loadAvatar(entry.target);
            io.unobserve(entry.target);
          });
        }, { rootMargin: "200px 0px" });
        cards.forEach(function(card) { io.observe(card); });
      }

      /* --- 鼠标跟随光晕（事件委托到网格容器，一次绑定） --- */
      function bindGlow() {
        document.querySelectorAll("[data-friends-grid]").forEach(function(grid) {
          if (grid.dataset.glowBound) return;
          grid.dataset.glowBound = "1";
          grid.addEventListener("mousemove", function(e) {
            var card = e.target.closest(".friend-card");
            if (!card) return;
            var rect = card.getBoundingClientRect();
            card.style.setProperty("--mouse-x", (e.clientX - rect.left) + "px");
            card.style.setProperty("--mouse-y", (e.clientY - rect.top) + "px");
          });
        });
      }

      /* --- 整卡点击（事件委托：click / Enter / Space；头像 overlay 链接优先） --- */
      function bindCardClick() {
        document.addEventListener("click", function(e) {
          var card = e.target.closest(".friend-card");
          if (!card || e.target.closest("a") || e.target.closest("button")) return;
          var href = card.dataset.href;
          if (href) window.open(href, "_blank", "noopener,noreferrer");
        });
        document.addEventListener("keydown", function(e) {
          if (e.key !== "Enter" && e.key !== " ") return;
          var card = e.target.closest(".friend-card");
          if (!card || e.target.closest("button")) return;
          var href = card.dataset.href;
          if (href) { e.preventDefault(); window.open(href, "_blank", "noopener,noreferrer"); }
        });
      }

      /* --- 状态注入：fetch friends-status.json 按 siteurl 匹配（无 JSON 静默隐藏） --- */
      var statusFetched = false;
      function bindStatus() {
        if (statusFetched) return;
        statusFetched = true;
        fetch("/friends-status.json")
          .then(function(r) { if (!r.ok) throw new Error("status json missing"); return r.json(); })
          .then(function(data) {
            var sites = data.sites || {};
            document.querySelectorAll(".friend-card").forEach(function(card) {
              var info = sites[card.dataset.siteurl];
              var tag = card.querySelector(".friend-status-tag");
              if (!tag || !info) return;
              tag.classList.add("friend-status-tag--" + info.status);
              tag.querySelector(".friend-status-text").textContent =
                info.status === "down" ? "DOWN" : (info.ms + " MS");
              tag.hidden = false;
            });
          })
          .catch(function() { /* 无 JSON：静默隐藏徽标 */ });
      }

      function init() {
        bindAvatarObserver();
        bindGlow();
        bindCardClick();
        bindStatus();
      }

      init();
      document.addEventListener("astro:page-load", init);
      document.addEventListener("swup:content:replaced", init);
    })();
  </script>

  <!-- 友链动态：Tab 切换 / 懒加载 data.json / 全部动态 / 单友链弹层 -->
  <script is:inline define:vars={{ dataUrl: circleConfig.dataUrl, pageSize: circleConfig.pageSize, cacheTime: circleConfig.cacheTime }}>
    (function() {
      if (window.__friendFeedReady) return;
      window.__friendFeedReady = true;

      var CACHE_KEY = "__friendsFeedCache";
      var feedData = null;
      var pending = null;
      var currentSort = "created";
      var displayed = 0;
      var modalHost = "";
      var modalName = "";
      var prefetchTimer = null;

      function $(sel, root) { return (root || document).querySelector(sel); }
      function $all(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

      function esc(t) {
        var d = document.createElement("div");
        d.textContent = t == null ? "" : String(t);
        return d.innerHTML;
      }

      /* 域名归一：小写、去末尾点、去 www.，失败返回空串 */
      function hostKey(raw) {
        if (!raw) return "";
        var s = String(raw).trim();
        if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(s)) s = "https://" + s;
        try {
          return new URL(s).hostname.toLowerCase().replace(/\.$/, "").replace(/^www\./, "");
        } catch (e) {
          return "";
        }
      }

      function formatDate(v) {
        return v ? String(v).split(" ")[0] : "";
      }

      function cardHtml(item) {
        var title = esc(item.title || "无标题");
        var author = esc(item.author || "未知");
        var link = esc(item.link || "#");
        var avatar = esc(item.avatar || "");
        var initial = esc((item.author || "?").slice(0, 1));
        var date = esc(formatDate(item.created));

        return '<a href="' + link + '" target="_blank" rel="noopener noreferrer" class="circle-card">' +
          '<div class="card-avatar-watermark" data-initial="' + initial + '">' +
            '<img src="' + avatar + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />' +
          '</div>' +
          '<span class="card-date-overlay">' + date + '</span>' +
          '<h3 class="card-title">' + title + '</h3>' +
          '<span class="card-author-tag">' + author + '</span>' +
        '</a>';
      }

      function sortedArticles() {
        var list = (feedData && feedData.article_data ? feedData.article_data : []).slice();
        var key = currentSort === "updated" ? "updated" : "created";
        list.sort(function(a, b) {
          var av = a[key] || a.created || "";
          var bv = b[key] || b.created || "";
          return bv.localeCompare(av);
        });
        return list;
      }

      function setFeedState(state) {
        var loading = $("[data-feed-loading]");
        var error = $("[data-feed-error]");
        var empty = $("[data-feed-empty]");
        var grid = $("[data-feed-grid]");
        var more = $("[data-feed-more]");
        if (loading) loading.hidden = state !== "loading";
        if (error) error.hidden = state !== "error";
        if (empty) empty.hidden = state !== "empty";
        if (grid) grid.hidden = state !== "grid";
        if (more) more.hidden = state !== "grid" || displayed >= sortedArticles().length;
      }

      function renderFeed() {
        var grid = $("[data-feed-grid]");
        if (!grid) return;
        var sorted = sortedArticles();
        if (!displayed) displayed = pageSize;
        grid.innerHTML = sorted.slice(0, displayed).map(cardHtml).join("");
        setFeedState("grid");
      }

      function renderStats(data) {
        var s = (data && data.statistical_data) || {};
        var friends = $("[data-feed-stat-friends]");
        var active = $("[data-feed-stat-active]");
        var articles = $("[data-feed-stat-articles]");
        if (friends) friends.textContent = String(s.friends_num || 0);
        if (active) active.textContent = String(s.active_num || 0);
        if (articles) articles.textContent = String(s.article_num || 0);

        var badge = $("[data-feed-count]");
        var total = data && data.article_data ? data.article_data.length : 0;
        if (badge) {
          badge.textContent = String(total);
          badge.hidden = total === 0;
        }
      }

      /* 数据里没有任何文章的友链，不展示「动态」按钮（避免点开只有空状态） */
      function syncFeedButtons(data) {
        var hosts = {};
        var names = {};
        ((data && data.article_data) || []).forEach(function(item) {
          var h = hostKey(item.link);
          if (h) hosts[h] = true;
          var n = (item.author || "").trim().toLowerCase();
          if (n) names[n] = true;
        });
        $all("[data-feed-host]").forEach(function(btn) {
          var h = hostKey(btn.getAttribute("data-feed-host"));
          var n = (btn.getAttribute("data-feed-name") || "").trim().toLowerCase();
          btn.hidden = !((h && hosts[h]) || (n && names[n]));
        });
      }

      /* 友链视图下空闲预取一次，用于判断哪些卡片该显示「动态」按钮 */
      function schedulePrefetch() {
        if (feedData) {
          syncFeedButtons(feedData);
          return;
        }
        if (pending || prefetchTimer) return;
        prefetchTimer = setTimeout(function() {
          prefetchTimer = null;
          if (!$("[data-friends-panel]")) return;
          ensureFeed(false);
        }, 1500);
      }

      function requestFeed(force) {
        if (!force && window[CACHE_KEY] && Date.now() - window[CACHE_KEY].time < cacheTime) {
          return Promise.resolve(window[CACHE_KEY].data);
        }
        return fetch(dataUrl, { cache: force ? "reload" : "default" })
          .then(function(res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.json();
          })
          .then(function(data) {
            window[CACHE_KEY] = { data: data, time: Date.now() };
            return data;
          });
      }

      function ensureFeed(force) {
        if (!force && feedData) {
          renderStats(feedData);
          syncFeedButtons(feedData);
          renderFeed();
          return Promise.resolve(feedData);
        }
        if (pending) return pending;
        setFeedState("loading");
        pending = requestFeed(force)
          .then(function(data) {
            pending = null;
            feedData = data;
            renderStats(data);
            syncFeedButtons(data);
            if (!data || !data.article_data || !data.article_data.length) {
              setFeedState("empty");
              return null;
            }
            renderFeed();
            return data;
          })
          .catch(function() {
            pending = null;
            feedData = null;
            setFeedState("error");
            return null;
          });
        return pending;
      }

      function activateTab(tab) {
        $all("[data-friends-tab]").forEach(function(btn) {
          var on = btn.getAttribute("data-friends-tab") === tab;
          btn.classList.toggle("is-active", on);
          btn.setAttribute("aria-selected", on ? "true" : "false");
        });
        $all("[data-friends-panel]").forEach(function(panel) {
          panel.hidden = panel.getAttribute("data-friends-panel") !== tab;
        });
        if (tab === "feed") ensureFeed(false);
        else schedulePrefetch();
      }

      /* ---------- 单友链动态弹层 ---------- */
      function setModalState(state) {
        var loading = $("[data-friend-modal-loading]");
        var error = $("[data-friend-modal-error]");
        var empty = $("[data-friend-modal-empty]");
        var grid = $("[data-friend-modal-grid]");
        if (loading) loading.hidden = state !== "loading";
        if (error) error.hidden = state !== "error";
        if (empty) empty.hidden = state !== "empty";
        if (grid) grid.hidden = state !== "grid";
      }

      function matchArticle(item) {
        var host = hostKey(item.link);
        if (host && modalHost && host === modalHost) return true;
        if (modalName && item.author && item.author.trim().toLowerCase() === modalName) return true;
        return false;
      }

      function renderModal(data) {
        var grid = $("[data-friend-modal-grid]");
        if (!grid) return;
        var matched = (data && data.article_data ? data.article_data : []).filter(matchArticle);
        matched.sort(function(a, b) {
          return (b.created || "").localeCompare(a.created || "");
        });
        if (!matched.length) {
          grid.innerHTML = "";
          setModalState("empty");
          return;
        }
        grid.innerHTML = matched.map(cardHtml).join("");
        setModalState("grid");
      }

      function openModal(btn) {
        var modal = $("#friend-feed-modal");
        if (!modal) return;
        modalHost = hostKey(btn.getAttribute("data-feed-host"));
        modalName = (btn.getAttribute("data-feed-name") || "").trim().toLowerCase();

        var name = btn.getAttribute("data-feed-name") || "";
        var avatar = btn.getAttribute("data-feed-avatar") || "";
        var site = btn.getAttribute("data-feed-site") || "";

        var img = $("[data-friend-modal-avatar]", modal);
        if (img) img.src = avatar;
        var nameEl = $("[data-friend-modal-name]", modal);
        if (nameEl) nameEl.textContent = name;
        var siteEl = $("[data-friend-modal-site]", modal);
        if (siteEl) {
          siteEl.href = site;
          siteEl.textContent = hostKey(site) || site;
        }

        modal.hidden = false;
        document.body.style.overflow = "hidden";
        setModalState("loading");

        ensureFeed(false).then(function(data) {
          if (modal.hidden) return;
          if (!data) {
            setModalState(feedData ? "empty" : "error");
            return;
          }
          renderModal(data);
        });
      }

      function closeModal() {
        var modal = $("#friend-feed-modal");
        if (!modal || modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = "";
        modalHost = "";
        modalName = "";
      }

      /* ---------- 事件委托（一次绑定，兼容 Swup 替换内容） ---------- */
      function bindEvents() {
        document.addEventListener("click", function(e) {
          var feedBtn = e.target.closest("[data-feed-host]");
          if (feedBtn) {
            e.preventDefault();
            openModal(feedBtn);
            return;
          }

          var tabBtn = e.target.closest("[data-friends-tab]");
          if (tabBtn) {
            activateTab(tabBtn.getAttribute("data-friends-tab"));
            return;
          }

          var sortBtn = e.target.closest("[data-feed-sort]");
          if (sortBtn) {
            currentSort = sortBtn.getAttribute("data-feed-sort") === "updated" ? "updated" : "created";
            $all("[data-feed-sort]").forEach(function(b) {
              b.classList.toggle("is-active", b === sortBtn);
            });
            if (feedData) renderFeed();
            return;
          }

          if (e.target.closest("[data-feed-loadmore]")) {
            displayed += pageSize;
            renderFeed();
            return;
          }

          if (e.target.closest("[data-feed-retry]")) {
            ensureFeed(true);
            return;
          }

          if (e.target.closest("[data-friend-modal-close]")) {
            closeModal();
          }
        });

        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape") closeModal();
        });
      }

      /* 把弹层挂到 body：页面容器上的 transform 会让 fixed 相对容器定位，导致弹层偏下 */
      function relocateModal() {
        var modals = document.querySelectorAll("#friend-feed-modal");
        if (!modals.length) return;
        var current = modals[0];
        for (var i = 1; i < modals.length; i++) modals[i].remove();
        if (current.parentElement !== document.body) document.body.appendChild(current);
      }

      function resetPage() {
        relocateModal();
        closeModal();
        if (!$("[data-friends-panel]")) return;

        currentSort = "created";
        displayed = pageSize;
        $all("[data-feed-sort]").forEach(function(b) {
          b.classList.toggle("is-active", b.getAttribute("data-feed-sort") === "created");
        });

        var tab = "list";
        try {
          if (new URLSearchParams(window.location.search).get("tab") === "feed") tab = "feed";
        } catch (e) { /* ignore */ }
        activateTab(tab);
      }

      bindEvents();
      resetPage();
      document.addEventListener("astro:page-load", resetPage);
      document.addEventListener("swup:willReplaceContent", closeModal);
      document.addEventListener("swup:content:replaced", resetPage);
    })();
  </script>

